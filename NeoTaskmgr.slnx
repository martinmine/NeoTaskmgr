<Solution>
  <Configurations>
    <Platform Name="ARM64" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="README.md" />
    <File Path="docs/PLAN.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/NeoTaskmgr.Core/NeoTaskmgr.Core.csproj">
      <Platform Solution="*|ARM64" Project="ARM64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|x86" Project="x86" />
      <Deploy Solution="*|x64" />
    </Project>
    <Project Path="src/NeoTaskmgr/NeoTaskmgr.csproj" >
      <Platform Solution="*|ARM64" Project="ARM64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|x86" Project="x86" />
      <Deploy Solution="*|x64" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/NeoTaskmgr.Core.Tests/NeoTaskmgr.Core.Tests.csproj" >
      <Platform Solution="*|ARM64" Project="ARM64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|x86" Project="x86" />
      <Deploy Solution="*|x64" />
    </Project>
  </Folder>
</Solution>
