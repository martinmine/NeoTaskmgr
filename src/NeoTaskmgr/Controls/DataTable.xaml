<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NeoTaskmgr.Controls.DataTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoTaskmgr.Controls">
    <UserControl.Resources>
        <!-- Applies to the cells of all rows. -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <!-- Scrolls horizontally when the columns are wider than the table; the list scrolls vertically. -->
    <ScrollViewer
        x:Name="HorizontalScroller"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        SizeChanged="HorizontalScroller_SizeChanged"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:TableRowPanel
                x:Name="HeaderPanel"
                MinHeight="36"
                Margin="16,0,4,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                CellSpacing="0"
                ContextRequested="HeaderPanel_ContextRequested" />
            <Rectangle
                Height="1"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <ListView
                x:Name="RowsList"
                Grid.Row="1"
                ContextRequested="RowsList_ContextRequested"
                SelectionChanged="RowsList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="Padding" Value="12,0,0,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!-- Cells fill the row height, so shaded cells of adjacent rows touch. -->
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </ScrollViewer>
</UserControl>
