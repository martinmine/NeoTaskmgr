<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NeoTaskmgr.Controls.DataTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoTaskmgr.Controls">
    <!-- Scrolls horizontally when the columns are wider than the table; the list scrolls vertically. -->
    <ScrollViewer
        x:Name="HorizontalScroller"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        SizeChanged="HorizontalScroller_SizeChanged"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Shifted left by half the row cell spacing, so each header straddles the gaps between columns like the
                shaded cells do, and its titles (padded by the other half) line up with the row content.
            -->
            <local:TableRowPanel
                x:Name="HeaderPanel"
                MinHeight="36"
                Margin="10,0,4,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                CellSpacing="0"
                ContextRequested="HeaderPanel_ContextRequested" />
            <Rectangle
                Height="1"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <ListView
                x:Name="RowsList"
                Grid.Row="1"
                ContextRequested="RowsList_ContextRequested"
                SelectionChanged="RowsList_SelectionChanged"
                SelectionMode="Single">
                <!--
                    No item animations: rows are reordered on every update (e.g. when sorted by CPU), and the ListView
                    plays a move as a delete and an add, so the default transitions make the rows fade out and in.
                -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <!--
                    By default the list keeps the first visible row in place when rows above it change. Rows are
                    reordered on every update, so that anchor keeps changing and the list jumps up and down; keep the
                    scroll position instead, like Task Manager.
                -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="Padding" Value="12,0,0,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!-- Cells fill the row height, so shaded cells of adjacent rows touch. -->
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </ScrollViewer>
</UserControl>
