<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoTaskmgr.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NeoTaskmgr">
    <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop/>
  </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="F"
                Invoked="FocusSearch_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator
                Key="Number1"
                Invoked="GoToPage_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number2"
                Invoked="GoToPage_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number3"
                Invoked="GoToPage_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number4"
                Invoked="GoToPage_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number5"
                Invoked="GoToPage_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="NeoTaskmgr"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="SearchBox"
                MinWidth="320"
                MaxWidth="560"
                VerticalAlignment="Center"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
        </TitleBar>

        <InfoBar
            x:Name="NotElevatedInfoBar"
            x:Uid="NotElevatedInfoBar"
            Grid.Row="1"
            Margin="8,0,8,4"
            Severity="Warning" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            OpenPaneLength="240"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavProcesses" Tag="Processes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPerformance" Tag="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavStartupApps" Tag="StartupApps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDetails" Tag="Details">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavServices" Tag="Services">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
