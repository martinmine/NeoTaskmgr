<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoTaskmgr.Pages.AppHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NeoTaskmgr.Controls"
    xmlns:local="using:NeoTaskmgr"
    xmlns:vm="using:NeoTaskmgr.ViewModels">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,8,16,0">
            <TextBlock
                x:Uid="AppHistoryPageTitle"
                MinHeight="40"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="24,0,16,0">
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
            <HyperlinkButton
                x:Uid="DeleteUsageHistoryButton"
                Margin="-12,0,0,0"
                Command="{x:Bind ViewModel.DeleteUsageHistoryCommand}" />
        </StackPanel>

        <controls:DataTable
            Grid.Row="2"
            Columns="{x:Bind ViewModel.Columns}"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}">
            <controls:DataTable.RowContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="OpenFileLocationMenuItem" Command="{x:Bind ViewModel.OpenFileLocationCommand}" />
                    <MenuFlyoutItem x:Uid="SearchOnlineMenuItem" Command="{x:Bind ViewModel.SearchOnlineCommand}" />
                    <MenuFlyoutItem x:Uid="PropertiesMenuItem" Command="{x:Bind ViewModel.PropertiesCommand}" />
                </MenuFlyout>
            </controls:DataTable.RowContextFlyout>

            <!-- One cell per column, in the order of AppHistoryViewModel.Columns. -->
            <controls:DataTable.ItemTemplate>
                <DataTemplate x:DataType="vm:AppHistoryRowViewModel">
                    <controls:TableRowPanel>
                        <Grid VerticalAlignment="Center" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{x:Bind local:IconCache.GetApp(ImagePath, PackageFamilyName), Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <!-- Shaded cells extend into the spacing so adjacent columns touch. -->
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(CpuHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind CpuTimeText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(NetworkHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind NetworkText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(NotificationsHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind NotificationsText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(DownloadsHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind DownloadsText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(UploadsHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind UploadsText, Mode=OneWay}" />
                        </Border>
                    </controls:TableRowPanel>
                </DataTemplate>
            </controls:DataTable.ItemTemplate>
        </controls:DataTable>
    </Grid>
</Page>
