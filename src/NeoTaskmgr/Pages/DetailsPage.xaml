<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoTaskmgr.Pages.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NeoTaskmgr.Controls"
    xmlns:vm="using:NeoTaskmgr.ViewModels">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="EndTaskAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,8,16,0">
            <TextBlock
                x:Uid="DetailsPageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right">
                <AppBarButton x:Uid="EndTaskButton" Command="{x:Bind ViewModel.EndTaskCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <controls:DataTable
            Grid.Row="1"
            Columns="{x:Bind ViewModel.Columns}"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}">
            <controls:DataTable.RowContextFlyout>
                <MenuFlyout Opening="RowMenu_Opening">
                    <MenuFlyoutItem x:Uid="EndTaskMenuItem" Command="{x:Bind ViewModel.EndTaskCommand}" />
                    <MenuFlyoutItem x:Uid="EndProcessTreeMenuItem" Command="{x:Bind ViewModel.EndProcessTreeCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="PriorityMenu" x:Uid="SetPriorityMenuItem">
                        <RadioMenuFlyoutItem x:Uid="PriorityRealTimeMenuItem" Command="{x:Bind ViewModel.SetPriorityCommand}" CommandParameter="RealTime" Tag="RealTime" />
                        <RadioMenuFlyoutItem x:Uid="PriorityHighMenuItem" Command="{x:Bind ViewModel.SetPriorityCommand}" CommandParameter="High" Tag="High" />
                        <RadioMenuFlyoutItem x:Uid="PriorityAboveNormalMenuItem" Command="{x:Bind ViewModel.SetPriorityCommand}" CommandParameter="AboveNormal" Tag="AboveNormal" />
                        <RadioMenuFlyoutItem x:Uid="PriorityNormalMenuItem" Command="{x:Bind ViewModel.SetPriorityCommand}" CommandParameter="Normal" Tag="Normal" />
                        <RadioMenuFlyoutItem x:Uid="PriorityBelowNormalMenuItem" Command="{x:Bind ViewModel.SetPriorityCommand}" CommandParameter="BelowNormal" Tag="BelowNormal" />
                        <RadioMenuFlyoutItem x:Uid="PriorityIdleMenuItem" Command="{x:Bind ViewModel.SetPriorityCommand}" CommandParameter="Idle" Tag="Idle" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Uid="SetAffinityMenuItem" Command="{x:Bind ViewModel.SetAffinityCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="OpenFileLocationMenuItem" Command="{x:Bind ViewModel.OpenFileLocationCommand}" />
                </MenuFlyout>
            </controls:DataTable.RowContextFlyout>

            <!-- One cell per column, in the order of DetailsViewModel.Columns. -->
            <controls:DataTable.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessRowViewModel">
                    <controls:TableRowPanel>
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind PidText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind UserName, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind SessionIdText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind CpuText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind CpuTimeText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind MemoryText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind WorkingSetText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind PeakWorkingSetText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind CommitSizeText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind HandlesText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind ThreadsText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind PriorityText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Architecture, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ElevatedText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ImagePath, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind CommandLine, Mode=OneWay}" />
                    </controls:TableRowPanel>
                </DataTemplate>
            </controls:DataTable.ItemTemplate>
        </controls:DataTable>
    </Grid>
</Page>
