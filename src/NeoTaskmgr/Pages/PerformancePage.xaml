<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoTaskmgr.Pages.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NeoTaskmgr.Controls"
    xmlns:local="using:NeoTaskmgr"
    xmlns:pages="using:NeoTaskmgr.Pages"
    xmlns:perf="using:NeoTaskmgr.ViewModels.Performance">
    <Page.Resources>
        <Style x:Key="GraphLabelStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValueStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <pages:PerformanceTemplateSelector x:Key="GraphsTemplateSelector">
            <pages:PerformanceTemplateSelector.CpuTemplate>
                <DataTemplate x:DataType="perf:CpuViewModel">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="CpuUtilizationLabel" Style="{StaticResource GraphLabelStyle}" />
                        <ToggleSwitch
                            x:Uid="LogicalProcessorsToggle"
                            Margin="0,-8,0,0"
                            HorizontalAlignment="Right"
                            IsOn="{x:Bind ShowLogicalProcessors, Mode=TwoWay}" />
                        <controls:PerformanceGraph
                            Grid.Row="1"
                            Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                            Maximum="{x:Bind History.Maximum, Mode=OneWay}"
                            Values="{x:Bind History.Values, Mode=OneWay}"
                            Visibility="{x:Bind local:XamlHelpers.Not(ShowLogicalProcessors), Mode=OneWay}" />
                        <ScrollViewer Grid.Row="1" Visibility="{x:Bind ShowLogicalProcessors, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ProcessorHistories}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="4"
                                        MinItemHeight="64"
                                        MinItemWidth="100"
                                        MinRowSpacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="perf:GraphHistory">
                                        <controls:PerformanceGraph Color="{x:Bind local:XamlHelpers.CpuColor}" Values="{x:Bind Values, Mode=OneWay}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </DataTemplate>
            </pages:PerformanceTemplateSelector.CpuTemplate>

            <pages:PerformanceTemplateSelector.MemoryTemplate>
                <DataTemplate x:DataType="perf:MemoryViewModel">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="MemoryUsageLabel" Style="{StaticResource GraphLabelStyle}" />
                        <controls:PerformanceGraph
                            Grid.Row="1"
                            Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                            Values="{x:Bind History.Values, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="MemoryCompositionLabel"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Style="{StaticResource GraphLabelStyle}" />
                        <!-- In use | Modified | Standby | Free -->
                        <Grid
                            Grid.Row="3"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Bind local:XamlHelpers.Star(Composition.InUse), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:XamlHelpers.Star(Composition.Modified), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:XamlHelpers.Star(Composition.Standby), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:XamlHelpers.Star(Composition.Free), Mode=OneWay}" />
                            </Grid.ColumnDefinitions>
                            <Border x:Uid="MemoryInUsePart" Background="#B08B12AE" />
                            <Border x:Uid="MemoryModifiedPart" Grid.Column="1" Background="#708B12AE" />
                            <Border x:Uid="MemoryStandbyPart" Grid.Column="2" Background="#308B12AE" />
                            <Border x:Uid="MemoryFreePart" Grid.Column="3" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </pages:PerformanceTemplateSelector.MemoryTemplate>

            <pages:PerformanceTemplateSelector.DiskTemplate>
                <DataTemplate x:DataType="perf:DiskViewModel">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="DiskActiveTimeLabel" Style="{StaticResource GraphLabelStyle}" />
                        <controls:PerformanceGraph
                            Grid.Row="1"
                            Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                            Values="{x:Bind History.Values, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="DiskTransferRateLabel"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Style="{StaticResource GraphLabelStyle}" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GraphLabelStyle}"
                            Text="{x:Bind TransferScale, Mode=OneWay}" />
                        <controls:PerformanceGraph
                            Grid.Row="3"
                            Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                            Maximum="{x:Bind ReadHistory.Maximum, Mode=OneWay}"
                            SecondaryValues="{x:Bind WriteHistory.Values, Mode=OneWay}"
                            Values="{x:Bind ReadHistory.Values, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </pages:PerformanceTemplateSelector.DiskTemplate>

            <pages:PerformanceTemplateSelector.NetworkTemplate>
                <DataTemplate x:DataType="perf:NetworkViewModel">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="NetworkThroughputLabel" Style="{StaticResource GraphLabelStyle}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource GraphLabelStyle}"
                            Text="{x:Bind Scale, Mode=OneWay}" />
                        <controls:PerformanceGraph
                            Grid.Row="1"
                            Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                            Maximum="{x:Bind History.Maximum, Mode=OneWay}"
                            SecondaryValues="{x:Bind SendHistory.Values, Mode=OneWay}"
                            Values="{x:Bind History.Values, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </pages:PerformanceTemplateSelector.NetworkTemplate>

            <pages:PerformanceTemplateSelector.GpuTemplate>
                <DataTemplate x:DataType="perf:GpuViewModel">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ItemsRepeater ItemsSource="{x:Bind Engines, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="2"
                                    MinColumnSpacing="12"
                                    MinItemHeight="110"
                                    MinItemWidth="200"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="perf:GpuEngineViewModel">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource GraphLabelStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource GraphLabelStyle}"
                                            Text="{x:Bind Utilization, Mode=OneWay}" />
                                        <controls:PerformanceGraph
                                            Grid.Row="1"
                                            Color="{x:Bind local:XamlHelpers.GpuColor}"
                                            Values="{x:Bind History.Values, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="GpuDedicatedMemoryLabel" Style="{StaticResource GraphLabelStyle}" />
                            <controls:PerformanceGraph
                                Grid.Row="1"
                                Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                                Maximum="{x:Bind DedicatedMemoryHistory.Maximum, Mode=OneWay}"
                                Values="{x:Bind DedicatedMemoryHistory.Values, Mode=OneWay}" />
                            <TextBlock
                                x:Uid="GpuSharedMemoryLabel"
                                Grid.Column="1"
                                Style="{StaticResource GraphLabelStyle}" />
                            <controls:PerformanceGraph
                                Grid.Row="1"
                                Grid.Column="1"
                                Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                                Maximum="{x:Bind SharedMemoryHistory.Maximum, Mode=OneWay}"
                                Values="{x:Bind SharedMemoryHistory.Values, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </pages:PerformanceTemplateSelector.GpuTemplate>
        </pages:PerformanceTemplateSelector>
    </Page.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" Padding="24,8,16,0">
            <TextBlock
                x:Uid="PerformancePageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right">
                <AppBarButton x:Uid="RunNewTaskButton" Command="{x:Bind ViewModel.RunNewTaskCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ListView
            x:Uid="PerformanceDeviceList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Devices}"
            SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="perf:PerformanceDeviceViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:PerformanceGraph
                            Height="48"
                            Color="{x:Bind local:XamlHelpers.DeviceColor(Kind)}"
                            Maximum="{x:Bind History.Maximum, Mode=OneWay}"
                            SecondaryValues="{x:Bind SecondaryHistory.Values, Mode=OneWay}"
                            ShowGrid="False"
                            Values="{x:Bind History.Values, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource GraphLabelStyle}"
                                Text="{x:Bind Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource GraphLabelStyle}"
                                Text="{x:Bind Detail, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind local:XamlHelpers.NotEmpty(Detail), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Padding="24,0,24,16"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontWeight="Normal"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectedDevice.Title, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="16"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectedDevice.Description, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <ContentControl
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.SelectedDevice, Mode=OneWay}"
                ContentTemplateSelector="{StaticResource GraphsTemplateSelector}"
                IsTabStop="False" />

            <!-- Like Task Manager: large statistics in rows, with a list of facts to their right. -->
            <Grid Grid.Row="2" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedDevice.StatRows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="perf:StatRow">
                            <ItemsRepeater ItemsSource="{x:Bind Stats}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="perf:StatViewModel">
                                        <StackPanel MinWidth="56">
                                            <TextBlock Style="{StaticResource GraphLabelStyle}" Text="{x:Bind Label}" />
                                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind Value, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.SelectedDevice.Properties, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="perf:StatViewModel">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource GraphLabelStyle}"
                                    Text="{x:Bind Label}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Value, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Value, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Grid>
    </Grid>
</Page>
