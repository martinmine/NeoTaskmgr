<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoTaskmgr.Pages.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NeoTaskmgr.Controls"
    xmlns:local="using:NeoTaskmgr"
    xmlns:pages="using:NeoTaskmgr.Pages"
    xmlns:vm="using:NeoTaskmgr.ViewModels">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="EndTaskAccelerator_Invoked" />

    </Page.KeyboardAccelerators>

    <Page.Resources>
        <pages:ProcessesRowTemplateSelector x:Key="RowTemplateSelector">
            <pages:ProcessesRowTemplateSelector.SectionTemplate>
                <DataTemplate x:DataType="vm:SectionRowViewModel">
                    <TextBlock
                        Margin="0,12,0,4"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneWay}" />
                </DataTemplate>
            </pages:ProcessesRowTemplateSelector.SectionTemplate>

            <!-- One cell per column, in the order of ProcessesViewModel.Columns. -->
            <pages:ProcessesRowTemplateSelector.ProcessTemplate>
                <DataTemplate x:DataType="vm:ProcessGroupRowViewModel">
                    <controls:TableRowPanel>
                        <Grid
                            Margin="{x:Bind local:XamlHelpers.Indent(IsChild)}"
                            VerticalAlignment="Center"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="20"
                                Height="20"
                                Padding="0"
                                AutomationProperties.Name="{x:Bind ExpandText, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ToggleExpandedCommand}"
                                Visibility="{x:Bind CanExpand, Mode=OneWay}">
                                <FontIcon FontSize="10" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                            </Button>
                            <Image
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Source="{x:Bind local:IconCache.Get(ImagePath), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Name, Mode=OneWay}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                            <FontIcon
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="{x:Bind EfficiencyModeText}"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xEC0A;"
                                ToolTipService.ToolTip="{x:Bind EfficiencyModeText}"
                                Visibility="{x:Bind ShowsEfficiencyLeaf, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Publisher, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind PidText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ProcessName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind CommandLine, Mode=OneWay}" />
                        <!-- Shaded cells extend into the spacing so adjacent columns touch. -->
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(CpuHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind CpuText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(MemoryHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind MemoryText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(DiskHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind DiskText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(NetworkHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind NetworkText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(GpuHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind GpuText, Mode=OneWay}" />
                        </Border>
                    </controls:TableRowPanel>
                </DataTemplate>
            </pages:ProcessesRowTemplateSelector.ProcessTemplate>
        </pages:ProcessesRowTemplateSelector>
    </Page.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,8,16,0">
            <TextBlock
                x:Uid="ProcessesPageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right">
                <AppBarButton x:Uid="RunNewTaskButton" Command="{x:Bind ViewModel.RunNewTaskCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="EndTaskButton" Command="{x:Bind ViewModel.EndTaskCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton
                    x:Uid="EfficiencyModeButton"
                    Command="{x:Bind ViewModel.ToggleEfficiencyModeCommand}"
                    IsChecked="{x:Bind ViewModel.IsSelectedEfficiencyMode, Mode=OneWay}">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xEC0A;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </CommandBar>
        </Grid>

        <controls:DataTable
            Grid.Row="1"
            Columns="{x:Bind ViewModel.Columns}"
            PreviewKeyDown="Table_PreviewKeyDown"
            ItemTemplateSelector="{StaticResource RowTemplateSelector}"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}">
            <controls:DataTable.RowContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="SwitchToMenuItem" Command="{x:Bind ViewModel.SwitchToCommand}" />
                    <MenuFlyoutItem x:Uid="EndTaskMenuItem" Command="{x:Bind ViewModel.EndTaskCommand}" />
                    <MenuFlyoutItem
                        x:Uid="RestartMenuItem"
                        Command="{x:Bind ViewModel.RestartExplorerCommand}"
                        Visibility="{x:Bind ViewModel.IsExplorerSelected, Mode=OneWay}" />
                    <ToggleMenuFlyoutItem
                        x:Uid="EfficiencyModeMenuItem"
                        Command="{x:Bind ViewModel.ToggleEfficiencyModeCommand}"
                        IsChecked="{x:Bind ViewModel.IsSelectedEfficiencyMode, Mode=OneWay}" />
                    <MenuFlyoutItem x:Uid="SuspendMenuItem" Command="{x:Bind ViewModel.SuspendCommand}" />
                    <MenuFlyoutItem x:Uid="ResumeMenuItem" Command="{x:Bind ViewModel.ResumeCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="CreateDumpFileMenuItem" Command="{x:Bind ViewModel.CreateDumpFileCommand}" />
                    <MenuFlyoutItem x:Uid="GoToDetailsMenuItem" Command="{x:Bind ViewModel.GoToDetailsCommand}" />
                    <MenuFlyoutItem x:Uid="GoToServicesMenuItem" Command="{x:Bind ViewModel.GoToServicesCommand}" />
                    <MenuFlyoutItem x:Uid="OpenFileLocationMenuItem" Command="{x:Bind ViewModel.OpenFileLocationCommand}" />
                    <MenuFlyoutItem x:Uid="SearchOnlineMenuItem" Command="{x:Bind ViewModel.SearchOnlineCommand}" />
                    <MenuFlyoutItem x:Uid="PropertiesMenuItem" Command="{x:Bind ViewModel.PropertiesCommand}" />
                </MenuFlyout>
            </controls:DataTable.RowContextFlyout>
        </controls:DataTable>
    </Grid>
</Page>
