<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoTaskmgr.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style
            x:Key="SettingsCardDescriptionStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="24,16"
            Spacing="4">
            <TextBlock
                x:Uid="SettingsPageTitle"
                Margin="0,0,0,16"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <Grid Style="{StaticResource SettingsCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="SettingsStartPageTitle" />
                    <TextBlock x:Uid="SettingsStartPageDescription" Style="{StaticResource SettingsCardDescriptionStyle}" />
                </StackPanel>
                <ComboBox
                    x:Uid="SettingsStartPageComboBox"
                    Grid.Column="1"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.StartPageIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="StartPageProcesses" />
                    <ComboBoxItem x:Uid="StartPagePerformance" />
                    <ComboBoxItem x:Uid="StartPageStartupApps" />
                    <ComboBoxItem x:Uid="StartPageDetails" />
                    <ComboBoxItem x:Uid="StartPageServices" />
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource SettingsCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="SettingsUpdateSpeedTitle" />
                    <TextBlock x:Uid="SettingsUpdateSpeedDescription" Style="{StaticResource SettingsCardDescriptionStyle}" />
                </StackPanel>
                <ComboBox
                    x:Uid="SettingsUpdateSpeedComboBox"
                    Grid.Column="1"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.UpdateSpeedIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="UpdateSpeedHigh" />
                    <ComboBoxItem x:Uid="UpdateSpeedNormal" />
                    <ComboBoxItem x:Uid="UpdateSpeedLow" />
                    <ComboBoxItem x:Uid="UpdateSpeedPaused" />
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource SettingsCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="SettingsThemeTitle" />
                    <TextBlock x:Uid="SettingsThemeDescription" Style="{StaticResource SettingsCardDescriptionStyle}" />
                </StackPanel>
                <ComboBox
                    x:Uid="SettingsThemeComboBox"
                    Grid.Column="1"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="ThemeSystem" />
                    <ComboBoxItem x:Uid="ThemeLight" />
                    <ComboBoxItem x:Uid="ThemeDark" />
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource SettingsCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="SettingsAlwaysOnTopTitle" />
                    <TextBlock x:Uid="SettingsAlwaysOnTopDescription" Style="{StaticResource SettingsCardDescriptionStyle}" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="SettingsAlwaysOnTopToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />
            </Grid>

            <Grid Style="{StaticResource SettingsCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="SettingsMinimizeOnUseTitle" />
                    <TextBlock x:Uid="SettingsMinimizeOnUseDescription" Style="{StaticResource SettingsCardDescriptionStyle}" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="SettingsMinimizeOnUseToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.MinimizeOnUse, Mode=TwoWay}" />
            </Grid>

            <TextBlock
                x:Uid="SettingsAboutHeader"
                Margin="0,24,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid Style="{StaticResource SettingsCardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NeoTaskmgr" />
                    <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{x:Bind ViewModel.Version}" />
                </StackPanel>
            </Grid>

            <TextBlock
                x:Uid="SettingsShortcutsHeader"
                Margin="0,24,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid Style="{StaticResource SettingsCardStyle}">
                <TextBlock x:Uid="SettingsShortcuts" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
