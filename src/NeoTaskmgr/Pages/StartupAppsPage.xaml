<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoTaskmgr.Pages.StartupAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NeoTaskmgr.Controls"
    xmlns:local="using:NeoTaskmgr"
    xmlns:vm="using:NeoTaskmgr.ViewModels">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,8,16,0">
            <TextBlock
                x:Uid="StartupAppsPageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right">
                <AppBarButton x:Uid="EnableButton" Command="{x:Bind ViewModel.EnableCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="DisableButton" Command="{x:Bind ViewModel.DisableCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <controls:DataTable
            Grid.Row="1"
            Columns="{x:Bind ViewModel.Columns}"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}">
            <controls:DataTable.RowContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="EnableMenuItem" Command="{x:Bind ViewModel.EnableCommand}" />
                    <MenuFlyoutItem x:Uid="DisableMenuItem" Command="{x:Bind ViewModel.DisableCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="OpenFileLocationMenuItem" Command="{x:Bind ViewModel.OpenFileLocationCommand}" />
                    <MenuFlyoutItem x:Uid="SearchOnlineMenuItem" Command="{x:Bind ViewModel.SearchOnlineCommand}" />
                    <MenuFlyoutItem x:Uid="PropertiesMenuItem" Command="{x:Bind ViewModel.PropertiesCommand}" />
                </MenuFlyout>
            </controls:DataTable.RowContextFlyout>

            <!-- One cell per column, in the order of StartupAppsViewModel.Columns. -->
            <controls:DataTable.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupRowViewModel">
                    <controls:TableRowPanel>
                        <Grid VerticalAlignment="Center" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{x:Bind local:IconCache.Get(TargetPath), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Publisher, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ImpactText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind TypeText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Command, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Location, Mode=OneWay}" />
                    </controls:TableRowPanel>
                </DataTemplate>
            </controls:DataTable.ItemTemplate>
        </controls:DataTable>
    </Grid>
</Page>
