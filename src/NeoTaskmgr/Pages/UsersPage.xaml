<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoTaskmgr.Pages.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NeoTaskmgr.Controls"
    xmlns:local="using:NeoTaskmgr"
    xmlns:pages="using:NeoTaskmgr.Pages"
    xmlns:vm="using:NeoTaskmgr.ViewModels">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="EndTaskAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <pages:UsersRowTemplateSelector x:Key="RowTemplateSelector">
            <!-- One cell per column, in the order of UsersViewModel.Columns. -->
            <pages:UsersRowTemplateSelector.UserTemplate>
                <DataTemplate x:DataType="vm:UserRowViewModel">
                    <controls:TableRowPanel>
                        <Grid VerticalAlignment="Center" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="20"
                                Height="20"
                                Padding="0"
                                AutomationProperties.Name="{x:Bind ExpandText, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ToggleExpandedCommand}"
                                Visibility="{x:Bind CanExpand, Mode=OneWay}">
                                <FontIcon FontSize="10" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                            </Button>
                            <Image
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Source="{x:Bind local:IconCache.GetPicture(PicturePath), Mode=OneWay}" />
                            <FontIcon
                                Grid.Column="1"
                                FontSize="14"
                                Glyph="&#xE77B;"
                                Visibility="{x:Bind local:XamlHelpers.Not(HasPicture), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Name, Mode=OneWay}" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind IdText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind SessionName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ClientName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                        <!-- Shaded cells extend into the spacing so adjacent columns touch. -->
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(CpuHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind CpuText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(MemoryHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind MemoryText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(DiskHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind DiskText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(NetworkHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind NetworkText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(GpuHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind GpuText, Mode=OneWay}" />
                        </Border>
                    </controls:TableRowPanel>
                </DataTemplate>
            </pages:UsersRowTemplateSelector.UserTemplate>

            <pages:UsersRowTemplateSelector.ProcessTemplate>
                <DataTemplate x:DataType="vm:ProcessGroupRowViewModel">
                    <controls:TableRowPanel>
                        <!-- Indented past the user's expand button, so the icons line up with the user's picture. -->
                        <Grid
                            Margin="26,0,0,0"
                            VerticalAlignment="Center"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{x:Bind local:IconCache.Get(ImagePath), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" />
                        </Grid>
                        <TextBlock />
                        <TextBlock />
                        <TextBlock />
                        <Grid>
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                            <FontIcon
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="{x:Bind EfficiencyModeText}"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xEC0A;"
                                ToolTipService.ToolTip="{x:Bind EfficiencyModeText}"
                                Visibility="{x:Bind ShowsEfficiencyLeaf, Mode=OneWay}" />
                        </Grid>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(CpuHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind CpuText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(MemoryHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind MemoryText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(DiskHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind DiskText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(NetworkHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind NetworkText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Margin="-6,0"
                            Padding="6,0"
                            Background="{x:Bind controls:HeatMap.Brush(GpuHeat), Mode=OneWay}">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind GpuText, Mode=OneWay}" />
                        </Border>
                    </controls:TableRowPanel>
                </DataTemplate>
            </pages:UsersRowTemplateSelector.ProcessTemplate>
        </pages:UsersRowTemplateSelector>
    </Page.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,8,16,0">
            <TextBlock
                x:Uid="UsersPageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right">
                <AppBarButton x:Uid="RunNewTaskButton" Command="{x:Bind ViewModel.RunNewTaskCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Uid="EndTaskButton"
                    Command="{x:Bind ViewModel.EndTaskCommand}"
                    Visibility="{x:Bind ViewModel.IsProcessSelected, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Uid="DisconnectButton"
                    Command="{x:Bind ViewModel.DisconnectCommand}"
                    Visibility="{x:Bind local:XamlHelpers.Not(ViewModel.IsProcessSelected), Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8F8;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="ManageUserAccountsButton" Command="{x:Bind ViewModel.ManageUserAccountsCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="SignOutButton" Command="{x:Bind ViewModel.SignOutCommand}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <controls:DataTable
            Grid.Row="1"
            Columns="{x:Bind ViewModel.Columns}"
            ItemTemplateSelector="{StaticResource RowTemplateSelector}"
            ItemsSource="{x:Bind ViewModel.Rows}"
            PreviewKeyDown="Table_PreviewKeyDown"
            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}">
            <controls:DataTable.RowContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.ToggleExpandedCommand}"
                        Text="{x:Bind ViewModel.ToggleExpandedText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsUserSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="DisconnectMenuItem"
                        Command="{x:Bind ViewModel.DisconnectCommand}"
                        Visibility="{x:Bind ViewModel.IsUserSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="SignOutMenuItem"
                        Command="{x:Bind ViewModel.SignOutCommand}"
                        Visibility="{x:Bind ViewModel.IsUserSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="ManageUserAccountsMenuItem"
                        Command="{x:Bind ViewModel.ManageUserAccountsCommand}"
                        Visibility="{x:Bind ViewModel.IsUserSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="EndTaskMenuItem"
                        Command="{x:Bind ViewModel.EndTaskCommand}"
                        Visibility="{x:Bind ViewModel.IsProcessSelected, Mode=OneWay}" />
                    <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.IsProcessSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="GoToDetailsMenuItem"
                        Command="{x:Bind ViewModel.GoToDetailsCommand}"
                        Visibility="{x:Bind ViewModel.IsProcessSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="OpenFileLocationMenuItem"
                        Command="{x:Bind ViewModel.OpenFileLocationCommand}"
                        Visibility="{x:Bind ViewModel.IsProcessSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="SearchOnlineMenuItem"
                        Command="{x:Bind ViewModel.SearchOnlineCommand}"
                        Visibility="{x:Bind ViewModel.IsProcessSelected, Mode=OneWay}" />
                    <MenuFlyoutItem
                        x:Uid="PropertiesMenuItem"
                        Command="{x:Bind ViewModel.PropertiesCommand}"
                        Visibility="{x:Bind ViewModel.IsProcessSelected, Mode=OneWay}" />
                </MenuFlyout>
            </controls:DataTable.RowContextFlyout>
        </controls:DataTable>
    </Grid>
</Page>
